{
  "name": "minecraft-ollama-admin-bot",
  "version": "0.1.0",
  "description": "Ollama-powered Minecraft admin/NPC bot with tool calling",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "setup:start": "powershell -ExecutionPolicy Bypass -File .\\scripts\\setup-and-start.ps1",
    "setup:stop": "powershell -ExecutionPolicy Bypass -File .\\scripts\\stop-system.ps1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "minecraft-data": "^3.85.0",
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
